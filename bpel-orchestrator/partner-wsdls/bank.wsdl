<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="BankService"
  targetNamespace="http://tp.bpel/bank/"
  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="http://tp.bpel/bank/"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"
  xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype">

  <wsdl:types>
    <xsd:schema targetNamespace="http://tp.bpel/bank/">
      <xsd:element name="payRequest">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="studentId" type="xsd:string"/>
          <xsd:element name="amount" type="xsd:decimal"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="payResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="approved" type="xsd:boolean"/>
          <xsd:element name="receipt" type="xsd:string"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="payIn"><wsdl:part name="payload" element="tns:payRequest"/></wsdl:message>
  <wsdl:message name="payOut"><wsdl:part name="payload" element="tns:payResponse"/></wsdl:message>

  <wsdl:portType name="BankPT">
    <wsdl:operation name="pay">
      <wsdl:input message="tns:payIn"/>
      <wsdl:output message="tns:payOut"/>
    </wsdl:operation>
  </wsdl:portType>

  <!-- Partner-link type - REQUIRED by BPEL -->
  <plnk:partnerLinkType name="BankLT">
    <plnk:role name="bankProvider" portType="tns:BankPT"/>
  </plnk:partnerLinkType>

  <wsdl:binding name="BankSOAP" type="tns:BankPT">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="pay">
      <soap:operation soapAction="pay"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="BankService">
    <wsdl:port name="BankPort" binding="tns:BankSOAP">
      <soap:address location="http://localhost:8080/bank-service/BankService"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
